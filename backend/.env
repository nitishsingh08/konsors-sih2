# AGNI-NETRA Backend Environment Variables

# App settings
PROJECT_NAME="AGNI-NETRA API"
VERSION="2.0.0"
API_V1_STR="/api"
DEBUG=True

# CORS - Add your Vercel frontend URL here
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","https://konsors-sih2.vercel.app"]

# PostgreSQL with PostGIS + pgvector (e.g., Supabase / Neon / Local)
# Local SQLite for development. Switch to PostgreSQL/PostGIS when a server
# is actually running -- an unreachable DATABASE_URL now degrades rather
# than blocking startup, but the DB-backed endpoints stay unavailable.
DATABASE_URL="sqlite:///./agninetra_local.db"

# NASA FIRMS API Key (optional for live feed)
FIRMS_MAP_KEY=""
POLL_INTERVAL_MINUTES=15

# Concurrency Guard Lock ID (PostgreSQL Advisory Lock)
ADVISORY_LOCK_ID=849201
